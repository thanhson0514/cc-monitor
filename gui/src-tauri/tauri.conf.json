{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccmon",
  "mainBinaryName": "ccmon-gui",
  "version": "0.3.0",
  "identifier": "io.github.wik1ngst-1103.ccmon",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": {
      "script": "yarn install --frozen-lockfile && yarn build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "ccmon — Claude Code monitor",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "publisher": "Le Thanh Son",
    "copyright": "Copyright (c) 2026 Le Thanh Son. MIT License.",
    "license": "MIT",
    "homepage": "https://cc-monitor.online",
    "category": "DeveloperTool",
    "shortDescription": "Watch Claude Code sessions, sub-agents and workflows live",
    "longDescription": "ccmon is a local desktop control center for Claude Code. It shows every step of your sessions live (prompts, tool calls, background tasks, sub-agents, workflows, side-by-side diffs, plan usage), and lets you manage skills, plugins, MCP servers, agents and workflows, and run sessions with your choice of model and effort.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
